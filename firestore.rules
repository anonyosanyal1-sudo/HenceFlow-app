rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Gate (Catch All Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Rules ---
    function isValidUser(data) {
      return data.uid == request.auth.uid 
          && data.email is string && data.email.size() <= 256
          && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 128))
          && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 512))
          && data.keys().hasAll(['uid', 'email'])
          && data.keys().size() <= 10;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isEmailVerified() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isEmailVerified() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming());
    }

    // --- Company Rules ---
    function isValidCompany(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 128
          && data.ownerId is string
          && data.adminIds is list && data.adminIds.size() <= 50
          && data.memberIds is list && data.memberIds.size() <= 200
          && data.keys().hasAll(['name', 'ownerId', 'adminIds', 'memberIds'])
          && data.keys().size() <= 10;
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/companies/$(companyId)).data.memberIds.hasAny([request.auth.uid]) ||
        get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid
      );
    }

    function isCompanyAdmin(companyId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/companies/$(companyId)).data.adminIds.hasAny([request.auth.uid]) ||
        get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid
      );
    }

    function isCompanyOwner(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid;
    }

    match /companies/{companyId} {
      allow get: if isCompanyMember(companyId);
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      
      allow create: if isEmailVerified() && isValidCompany(incoming()) && incoming().ownerId == request.auth.uid;
      
      allow update: if isEmailVerified() && isCompanyAdmin(companyId) 
                       && isValidCompany(incoming())
                       && incoming().ownerId == existing().ownerId
                       && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'memberIds', 'adminIds', 'updatedAt']);
                       
      allow delete: if isEmailVerified() && resource.data.ownerId == request.auth.uid;
    }

    // --- Project Rules ---
    function isValidProject(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 128
          && data.ownerId is string
          && data.members is list && data.members.size() <= 50
          && (data.stages == null || (data.stages is list && data.stages.size() <= 20))
          && data.keys().hasAll(['name', 'ownerId', 'members'])
          && data.keys().size() <= 10;
    }

    function isProjectMember(projectId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/projects/$(projectId)).data.members.hasAny([request.auth.uid]) ||
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid
      );
    }

    function isProjectOwner(projectId) {
      return isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    match /projects/{projectId} {
      allow get: if isProjectMember(projectId);
      allow list: if isSignedIn() && request.auth.uid in resource.data.members;
      
      allow create: if isEmailVerified() && isValidProject(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isEmailVerified() && isProjectOwner(projectId) 
                       && isValidProject(incoming())
                       && incoming().ownerId == existing().ownerId
                       && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'members', 'companyId', 'color', 'stages']);
      allow delete: if isEmailVerified() && isProjectOwner(projectId);
    }

    // --- Task Rules ---
    function isValidTask(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 256
          && data.projectId is string && isValidId(data.projectId)
          && data.creatorId == request.auth.uid
          && data.status is string && data.status.size() <= 64
          && data.priority in ['low', 'medium', 'high', 'urgent']
          && (data.assigneeId == null || (data.assigneeId is string && isValidId(data.assigneeId)))
          && data.keys().hasAll(['title', 'projectId', 'creatorId', 'status', 'priority'])
          && data.keys().size() <= 15;
    }

    match /projects/{projectId}/tasks/{taskId} {
      allow get: if isProjectMember(projectId);
      allow list: if isProjectMember(projectId);
      
      allow create: if isEmailVerified() && isValidId(projectId) && isValidId(taskId) 
                       && isProjectMember(projectId)
                       && isValidTask(incoming())
                       && incoming().projectId == projectId;
      
      allow update: if isEmailVerified() && isValidId(projectId) && isValidId(taskId)
                       && isProjectMember(projectId)
                       && isValidTask(incoming())
                       && incoming().projectId == existing().projectId
                       && incoming().creatorId == existing().creatorId
                       && (
                         // Action: Full Update (Owner/Creator)
                         (incoming().creatorId == request.auth.uid || isProjectOwner(projectId)) ||
                         // Action: Status Update Only (Member)
                         (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                       );
      
      allow delete: if isEmailVerified() && isValidId(projectId) && isValidId(taskId)
                       && (isProjectOwner(projectId) || existing().creatorId == request.auth.uid);
    }

    // --- Comment Rules ---
    function isValidComment(data) {
      return data.content is string && data.content.size() <= 2048
          && data.userId is string
          && data.taskId is string
          && data.projectId is string
          && data.attachments is list && data.attachments.size() <= 10
          && (data.content.size() > 0 || data.attachments.size() > 0)
          && data.keys().hasAll(['content', 'userId', 'taskId', 'projectId', 'attachments'])
          && data.keys().size() <= 15;
    }

    match /projects/{projectId}/tasks/{taskId}/comments/{commentId} {
      allow get: if isProjectMember(projectId);
      allow list: if isProjectMember(projectId);
      allow create: if isEmailVerified() && isProjectMember(projectId) && isValidComment(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isEmailVerified() && isProjectMember(projectId) && isValidComment(incoming()) 
                       && incoming().userId == existing().userId 
                       && incoming().taskId == existing().taskId
                       && incoming().projectId == existing().projectId
                       && (
                         (request.auth.uid == existing().userId && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'likes', 'dislikes', 'isEdited', 'updatedAt'])) ||
                         (incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'dislikes', 'updatedAt']))
                       );
      allow delete: if isEmailVerified() && (isProjectOwner(projectId) || existing().userId == request.auth.uid);
    }
  }
}
